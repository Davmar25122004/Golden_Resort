/* ── FUENTES LOCALES ── */
@font-face {
    font-family: 'Cormorant Garamond';
    src: url('../lib/fonts/cormorant/cormorant-garamond-v21-latin-regular.woff2') format('woff2');
    font-weight: 400; font-style: normal;
}
@font-face {
    font-family: 'Cormorant Garamond';
    src: url('../lib/fonts/cormorant/cormorant-garamond-v21-latin-italic.woff2') format('woff2');
    font-weight: 400; font-style: italic;
}
@font-face {
    font-family: 'Cormorant Garamond';
    src: url('../lib/fonts/cormorant/cormorant-garamond-v21-latin-600.woff2') format('woff2');
    font-weight: 600; font-style: normal;
}
@font-face {
    font-family: 'Montserrat';
    src: url('../lib/fonts/motserrat/montserrat-v31-latin-300.woff2') format('woff2');
    font-weight: 300; font-style: normal;
}
@font-face {
    font-family: 'Montserrat';
    src: url('../lib/fonts/motserrat/montserrat-v31-latin-regular.woff2') format('woff2');
    font-weight: 400; font-style: normal;
}
@font-face {
    font-family: 'Montserrat';
    src: url('../lib/fonts/motserrat/montserrat-v31-latin-500.woff2') format('woff2');
    font-weight: 500; font-style: normal;
}
@font-face {
    font-family: 'Montserrat';
    src: url('../lib/fonts/motserrat/montserrat-v31-latin-600.woff2') format('woff2');
    font-weight: 600; font-style: normal;
}

:root {
    --gold:    #C9A84C;
    --gold-light: #E8D5A3;
    --dark:    #0D0D0D;
    --dark-2:  #1A1A1A;
    --dark-3:  #252525;
    --cream:   #F5F0E8;
    --accent:  #8B1A1A;
    --text-muted-custom: #9A9A9A;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Montserrat', sans-serif;
    background: var(--dark);
    color: var(--cream);
    overflow-x: hidden;
}

h1, h2, h3, h4, .serif {
    font-family: 'Cormorant Garamond', serif;
}

/* ── NAVBAR ── */
#navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 20px 0;
    transition: all 0.4s ease;
    background: transparent;
}
#navbar.scrolled {
    background: rgba(13,13,13,0.97);
    padding: 12px 0;
    border-bottom: 1px solid rgba(201,168,76,0.2);
    backdrop-filter: blur(10px);
}
.navbar-brand-custom {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--gold) !important;
    letter-spacing: 2px;
    text-decoration: none;
}
.nav-link-custom {
    color: var(--cream) !important;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 8px 16px !important;
    transition: color 0.3s;
    text-decoration: none;
}
.nav-link-custom:hover { color: var(--gold) !important; }
.btn-reservar {
    background: var(--gold);
    color: var(--dark) !important;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    border: none;
    cursor: pointer;
    transition: background 0.3s;
    text-decoration: none;
}
.btn-reservar:hover { background: var(--gold-light); }
.btn-reservar--search { padding: 12px; }
.btn-reservar--full { width: 100%; padding: 14px; }

/* ── HERO ── */
#hero {
    height: 100vh;
    min-height: 700px;
    background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.65)),
                url('/images/hero-bg.jpg') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
}
.hero-title {
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 400;
    color: var(--cream);
    line-height: 1.1;
    margin-bottom: 0.5rem;
}
.hero-subtitle {
    font-size: 0.8rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 3rem;
}
.hero-tagline {
    margin-top: 8px;
    font-size: 0.7rem;
    margin-bottom: 3rem;
}
.search-glass {
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(201,168,76,0.3);
    padding: 28px 36px;
    border-radius: 4px;
    max-width: 700px;
    margin: 0 auto;
}
.search-glass .form-control {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(201,168,76,0.4);
    color: var(--cream);
    border-radius: 2px;
    padding: 12px 16px;
}
.search-glass .form-control:focus {
    background: rgba(255,255,255,0.1);
    border-color: var(--gold);
    box-shadow: none;
    color: var(--cream);
}
.search-glass label {
    color: var(--gold-light);
    font-size: 0.7rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
}

/* ── FLATPICKR LUXURY THEME ── */
.flatpickr-calendar {
    background: var(--dark-2);
    border: 1px solid rgba(201,168,76,0.35);
    border-radius: 2px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.6);
    font-family: 'Montserrat', sans-serif;
    color: var(--cream);
}
.flatpickr-calendar.arrowTop::before,
.flatpickr-calendar.arrowTop::after { border-bottom-color: var(--dark-2); }
.flatpickr-months .flatpickr-month,
.flatpickr-weekdays,
span.flatpickr-weekday {
    background: var(--dark-2);
    color: var(--gold-light);
    fill: var(--gold-light);
}
.flatpickr-current-month .flatpickr-monthDropdown-months,
.flatpickr-current-month input.cur-year {
    background: transparent;
    color: var(--cream);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 1px;
}
.flatpickr-prev-month, .flatpickr-next-month {
    color: var(--gold) !important;
    fill: var(--gold) !important;
}
.flatpickr-prev-month:hover svg, .flatpickr-next-month:hover svg { fill: var(--gold-light) !important; }
.flatpickr-day {
    color: var(--cream);
    border-radius: 2px;
    border: none;
}
.flatpickr-day:hover {
    background: var(--dark-3);
    border-color: var(--gold);
    color: var(--gold-light);
}
.flatpickr-day.selected,
.flatpickr-day.selected:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--dark);
    font-weight: 600;
}
.flatpickr-day.today {
    border-color: rgba(201,168,76,0.5);
    color: var(--gold);
}
.flatpickr-day.today:hover {
    background: var(--dark-3);
    border-color: var(--gold);
    color: var(--gold);
}
.flatpickr-day.flatpickr-disabled,
.flatpickr-day.flatpickr-disabled:hover {
    color: rgba(245,240,232,0.2);
}
.numInputWrapper span.arrowUp::after {
    border-bottom-color: var(--cream) !important;
}
.numInputWrapper span.arrowDown::after {
    border-top-color: var(--cream) !important;
}
.fp-month-wrap { display: inline-block; }
.fp-month-btn {
    cursor: pointer;
    color: var(--cream);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    padding: 2px 8px 2px 6px;
    border: 1px solid rgba(201,168,76,0.35);
    border-radius: 2px;
    user-select: none;
    letter-spacing: 0.5px;
}
.fp-month-btn:hover { color: var(--gold); border-color: var(--gold); }
.fp-month-list {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    background: var(--dark-3);
    border: 1px solid rgba(201,168,76,0.35);
    border-radius: 2px;
    z-index: 99999;
    min-width: 130px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.6);
}
.fp-month-wrap.open .fp-month-list { display: block; }
.fp-month-item {
    padding: 8px 16px;
    color: var(--cream);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    cursor: pointer;
    letter-spacing: 0.5px;
}
.fp-month-item:hover { background: var(--dark-2); color: var(--gold-light); }
.fp-month-item.active { color: var(--gold); font-weight: 600; }
.numInputWrapper input.numInput {
    background: var(--dark-3);
    color: var(--cream);
    border: 1px solid rgba(201,168,76,0.35);
    border-radius: 2px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
}
.numInputWrapper:hover { background: transparent; }

/* ── SECTIONS ── */
section { padding: 100px 0; }
.section-label {
    font-size: 0.65rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
}
.section-title {
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 400;
    color: var(--cream);
    margin-bottom: 60px;
}
.gold-line {
    width: 60px;
    height: 1px;
    background: var(--gold);
    margin: 16px auto 0;
}

/* ── HABITACIONES SWIPER ── */
#habitaciones { background: var(--dark-2); }
.swiper { padding-bottom: 50px !important; }
.swiper-slide { width: 340px; }
.room-card {
    background: var(--dark-3);
    border: 1px solid rgba(201,168,76,0.15);
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s;
}
.room-card:hover {
    border-color: var(--gold);
    transform: translateY(-4px);
}
.room-card-img {
    height: 220px;
    width: 100%;
    position: relative;
    overflow: hidden;
    cursor: pointer;
}
.room-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
}
.room-card-img:hover img { transform: scale(1.06); }
.room-img-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
}
.room-card-img:hover .room-img-overlay { background: rgba(0,0,0,0.38); }
.room-img-overlay-text {
    color: var(--cream);
    font-size: 0.65rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.3s ease;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 4px;
}
.room-card-img:hover .room-img-overlay-text { opacity: 1; transform: translateY(0); }

/* ── ROOM LIGHTBOX ── */
.room-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    transition: background 0.3s ease;
    cursor: pointer;
}
.room-lightbox.active { background: rgba(0,0,0,0.92); }
.room-lightbox-inner {
    position: relative;
    max-width: 900px;
    width: 100%;
    opacity: 0;
    transform: scale(0.95);
    transition: all 0.4s ease;
    cursor: default;
}
.room-lightbox.active .room-lightbox-inner { opacity: 1; transform: scale(1); }
.room-lightbox-imgwrap { position: relative; background: #000; }
.room-lightbox-img {
    width: 100%;
    max-height: 65vh;
    object-fit: cover;
    display: block;
}
.room-lightbox-img-next {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
}
.room-lightbox-img-next.visible { opacity: 1; }
.room-lb-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(13,13,13,0.75);
    border: 1px solid rgba(201,168,76,0.4);
    color: var(--gold);
    width: 44px;
    height: 44px;
    font-size: 1.6rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    z-index: 1;
    line-height: 1;
}
.room-lb-arrow:hover { background: var(--gold); color: var(--dark); }
.room-lb-arrow.lb-hidden { display: none; }
.room-lb-prev { left: 12px; }
.room-lb-next { right: 12px; }
.room-lb-counter {
    position: absolute;
    bottom: 12px;
    right: 12px;
    font-size: 0.6rem;
    letter-spacing: 2px;
    color: var(--cream);
    background: rgba(0,0,0,0.6);
    padding: 4px 10px;
}
.room-lightbox-caption {
    background: var(--dark-2);
    border: 1px solid rgba(201,168,76,0.3);
    border-top: none;
    padding: 20px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 96px; /* Asegura espacio para el texto y los puntos */
}
.room-lightbox-caption-right { text-align: right; }
.room-lightbox-name-text { color: var(--cream); font-size: 1.6rem; margin: 0; }
.room-lightbox-price-text { color: var(--gold); font-size: 1.1rem; margin: 0; }
.room-type-badge--lb { margin-bottom: 4px; }
.room-lb-dots {
    display: flex;
    gap: 7px;
    justify-content: flex-end;
    margin-top: 10px;
}
.room-lb-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0; /* Evita que se deformen en pantallas pequeñas */
    border-radius: 50%;
    background: rgba(201,168,76,0.3);
    cursor: pointer;
    transition: background 0.3s;
}
.room-lb-dot.active { background: var(--gold); }
.room-lightbox-close {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 40px;
    height: 40px;
    background: var(--gold);
    color: var(--dark);
    border: none;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    z-index: 1;
    transition: background 0.3s;
    line-height: 1;
}
.room-lightbox-close:hover { background: var(--gold-light); }
.room-card-body { padding: 24px; }
.room-type-badge {
    font-size: 0.6rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 8px;
}
.room-name { font-size: 1.4rem; color: var(--cream); margin-bottom: 8px; }
.room-price { font-size: 1.1rem; color: var(--gold); }
.room-price small { font-size: 0.7rem; color: var(--text-muted-custom); }
.btn-room {
    width: 100%;
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 0.7rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 12px;
    margin-top: 16px;
    cursor: pointer;
    transition: all 0.3s;
}
.btn-room:hover { background: var(--gold); color: var(--dark); }
.swiper-pagination-bullet { background: var(--gold) !important; }
.swiper-button-next, .swiper-button-prev { color: var(--gold) !important; }
#no-rooms-msg { display: none; color: var(--text-muted-custom); text-align: center; padding: 40px; }

/* ── SERVICIOS ── */
#servicios { background: var(--dark); }
.servicio-card {
    background: var(--dark-2);
    border: 1px solid rgba(201,168,76,0.1);
    padding: 36px 28px;
    text-align: center;
    transition: border-color 0.3s, transform 0.3s;
}
.servicio-card:hover { border-color: var(--gold); transform: translateY(-4px); }
.servicio-card--clickable { cursor: pointer; }
.servicio-card--img {
    position: relative;
    height: 280px;
    padding: 0;
    background-size: cover;
    background-position: center;
    border: none;
    overflow: hidden;
}
.servicio-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.82) 40%, rgba(0,0,0,0.25) 100%);
    transition: background 0.4s;
}
.servicio-card--img:hover .servicio-card-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.88) 40%, rgba(0,0,0,0.45) 100%);
}
.servicio-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 22px;
    text-align: left;
}
.servicio-card--img:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(201,168,76,0.18); border: none; }
.servicio-card-hint { font-size: 0.68rem; letter-spacing: 2px; color: rgba(255,255,255,0.45); margin-top: 6px; margin-bottom: 0; text-transform: uppercase; transition: color 0.3s; }
.servicio-card--img:hover .servicio-card-hint { color: var(--gold); }
.servicio-name { font-size: 1.25rem; color: var(--cream); margin-bottom: 4px; }
.servicio-price { font-size: 0.85rem; color: var(--gold); font-weight: 600; margin: 0; }

/* ── CONTACTO ── */
#contacto {
    background: linear-gradient(rgba(0,0,0,0.70), rgba(0,0,0,0.75)),
                url('/images/xavier-coiffic-lQ4mfS5Le6M-unsplash.jpg') center/cover no-repeat;
    padding: 100px 0;
}

.contacto-inner {
    display: flex;
    gap: 48px;
    align-items: stretch;
}

.contacto-map-col {
    flex: 0 0 48%;
    border: 1px solid rgba(201,168,76,0.35);
    overflow: hidden;
    border-radius: 2px;
    position: relative;
    cursor: pointer;
    text-decoration: none;
    display: block;
}

.contacto-map-col::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 52px;
    background: #263238;
    pointer-events: none;
    z-index: 2;
}

.contacto-map-iframe {
    width: 100%;
    height: calc(100% + 52px);
    min-height: 432px;
    margin-top: -52px;
    border: none;
    display: block;
    filter: grayscale(25%) contrast(1.05);
    pointer-events: none;
}

.contacto-map-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 20px;
    background: linear-gradient(transparent 55%, rgba(0,0,0,0.55) 100%);
    opacity: 0;
    transition: opacity 0.25s;
}

.contacto-map-col:hover .contacto-map-overlay { opacity: 1; }

.contacto-map-cta {
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--cream);
    background: rgba(201,168,76,0.85);
    padding: 8px 20px;
    border-radius: 2px;
}

.contacto-info-col {
    flex: 1;
    display: flex;
    align-items: center;
}

.contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px 24px;
    width: 100%;
}

.contact-info-item { margin-bottom: 0; }
.contact-label {
    font-size: 0.65rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 6px;
}
.contact-value { color: var(--cream); font-size: 0.92rem; line-height: 1.7; }
.contact-value--coords { font-style: italic; font-size: 0.82rem; color: var(--text-muted-custom); }

.contacto-email-link { color: var(--gold); text-decoration: none; }
.contacto-email-link:hover { color: var(--gold-light); }

.contacto-social { display: flex; gap: 10px; margin-top: 4px; }
.contacto-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: rgba(201,168,76,0.12);
    border: 1px solid rgba(201,168,76,0.4);
    color: var(--gold);
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
}
.contacto-social-btn:hover { background: var(--gold); color: var(--dark); }

@media (max-width: 768px) {
    .contacto-inner { flex-direction: column; gap: 28px; }
    .contacto-map-iframe { min-height: 260px; }
    .contacto-grid { grid-template-columns: 1fr; gap: 24px; }
}

/* ── FOOTER ── */
footer {
    background: #080808;
    padding: 40px 0;
    border-top: 1px solid rgba(201,168,76,0.15);
}
.footer-brand { font-size: 1.4rem; color: var(--gold); letter-spacing: 3px; }
.footer-text { font-size: 0.75rem; color: var(--text-muted-custom); letter-spacing: 1px; }

/* ── MODAL AUTH ── */
.modal-dark .modal-content {
    background: var(--dark-2);
    border: 1px solid rgba(201,168,76,0.3);
    border-radius: 2px;
}
.modal-dark .modal-body { padding: 40px; }
.modal-dark .nav-pills .nav-link {
    color: var(--text-muted-custom);
    font-size: 0.7rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-radius: 0;
    padding: 10px 24px;
}
.modal-dark .nav-pills .nav-link.active {
    background: transparent;
    color: var(--gold);
    border-bottom: 1px solid var(--gold);
}
.modal-dark .form-label {
    color: var(--gold-light);
    font-size: 0.65rem;
    letter-spacing: 2px;
    text-transform: uppercase;
}
.modal-dark .form-control {
    background: var(--dark-3);
    border: 1px solid rgba(201,168,76,0.25);
    color: var(--cream);
    border-radius: 2px;
}
.modal-dark .form-control:focus {
    border-color: var(--gold);
    box-shadow: none;
    background: var(--dark-3);
    color: var(--cream);
}
.btn-gold {
    background: var(--gold);
    color: var(--dark);
    border: none;
    font-size: 0.7rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 14px;
    width: 100%;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.3s;
}
.btn-gold:hover { background: var(--gold-light); }

/* ── NAV ELEMENTOS OCULTOS ── */
#nav-mis-reservas,
#nav-admin,
#btn-reservar-nav,
#nav-user { display: none; }

#nav-user {
    font-size: 0.7rem;
    color: var(--gold-light);
    letter-spacing: 1px;
}

/* ── ADMIN / MIS RESERVAS ── */
#main-content {
    display: none;
    background: var(--dark);
    padding-top: 100px;
    min-height: 80vh;
}
.admin-table { color: var(--cream); }
.admin-table th { color: var(--gold); font-size: 0.7rem; letter-spacing: 2px; text-transform: uppercase; border-color: rgba(201,168,76,0.2); }
.admin-table td { border-color: rgba(255,255,255,0.05); color: var(--cream); }
.reserva-card-luxury {
    background: var(--dark-2);
    border: 1px solid rgba(201,168,76,0.15);
    padding: 28px;
    margin-bottom: 20px;
}

/* ── RESERVA FORM ── */
.reserva-form-container {
    background: var(--dark-2);
    border: 1px solid rgba(201,168,76,0.2);
    padding: 48px;
    max-width: 700px;
    margin: 0 auto;
}
.servicio-select-item {
    background: var(--dark-3);
    border: 1px solid rgba(201,168,76,0.1);
    padding: 16px 20px;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.qty-input {
    background: var(--dark);
    border: 1px solid rgba(201,168,76,0.3);
    color: var(--cream);
    width: 70px;
    padding: 6px 10px;
    text-align: center;
}

/* ── VISTA DE DETALLE POR TIPO ──────────────────────────────────────────────── */

.detail-view-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 20px 80px;
}

.detailSwiper {
    width: 100%;
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
    background: #111;
}

.detail-swiper-slide {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.detail-swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.detailSwiper .swiper-button-next,
.detailSwiper .swiper-button-prev {
    color: var(--gold);
}

.detailSwiper .swiper-pagination-bullet {
    background: var(--gold);
    opacity: 0.5;
}

.detailSwiper .swiper-pagination-bullet-active {
    opacity: 1;
}

.detail-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    color: var(--gold);
    margin-top: 32px;
    margin-bottom: 16px;
    letter-spacing: 1px;
}

.detail-description {
    color: var(--text-muted-custom);
    font-size: 1rem;
    line-height: 1.8;
    max-width: 680px;
    margin-bottom: 40px;
}

.btn-room--disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
}

/* ── MIS RESERVAS ──────────────────────────────────────────────────────────── */

.reservas-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 860px;
    margin: 0 auto;
}

.reserva-card {
    display: flex;
    background: var(--dark-3);
    border: 1px solid rgba(201,168,76,0.15);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s;
}

.reserva-card:hover {
    border-color: rgba(201,168,76,0.5);
    transform: translateY(-2px);
}

.reserva-card--pasada {
    opacity: 0.5;
}

.reserva-card-img {
    width: 200px;
    min-width: 200px;
    height: 160px;
    object-fit: cover;
    display: block;
}

.reserva-card-body {
    flex: 1;
    padding: 20px 24px;
    border-left: 1px solid rgba(201,168,76,0.12);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
}

.reserva-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.reserva-tipo-label {
    font-size: 0.6rem;
    letter-spacing: 3px;
    color: var(--text-muted-custom);
    text-transform: uppercase;
}

.reserva-estado-badge {
    font-size: 0.6rem;
    letter-spacing: 2px;
    padding: 3px 10px;
    border-radius: 20px;
    font-family: 'Montserrat', sans-serif;
    white-space: nowrap;
}

.reserva-hab-num {
    font-size: 0.75rem;
    color: var(--text-muted-custom);
    letter-spacing: 1px;
}

.reserva-dates {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    color: var(--cream);
    letter-spacing: 0.5px;
}

.reserva-dates span {
    color: var(--gold);
    margin: 0 8px;
}

.reserva-meta {
    font-size: 0.72rem;
    color: var(--text-muted-custom);
    letter-spacing: 1px;
}

.reserva-meta strong {
    color: var(--cream);
    font-weight: 500;
}

.btn-cancelar {
    align-self: flex-start;
    background: transparent;
    border: 1px solid rgba(139,26,26,0.5);
    color: #c0392b;
    padding: 6px 18px;
    font-size: 0.65rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.25s, border-color 0.25s;
    font-family: 'Montserrat', sans-serif;
}

.btn-cancelar:hover {
    background: rgba(139,26,26,0.15);
    border-color: #c0392b;
}

.reserva-empty {
    text-align: center;
    padding: 80px 20px;
}

.reserva-empty-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    color: var(--cream);
    margin-bottom: 12px;
    font-weight: 400;
}

.reserva-empty-sub {
    color: var(--text-muted-custom);
    font-size: 0.8rem;
    letter-spacing: 2px;
    margin-bottom: 32px;
}

.btn-reserva-empty {
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    padding: 12px 32px;
    font-size: 0.7rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 4px;
    font-family: 'Montserrat', sans-serif;
    transition: background 0.3s, color 0.3s;
}

.btn-reserva-empty:hover {
    background: var(--gold);
    color: var(--dark);
}

@media (max-width: 600px) {
    .reserva-card { flex-direction: column; }
    .reserva-card-img { width: 100%; min-width: unset; height: 180px; }
    .reserva-card-body { border-left: none; border-top: 1px solid rgba(201,168,76,0.12); }
}

/* ── SERVICIO DETAIL PAGE ── */

/* 4.1 Contenedor principal */
.servicio-detail-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 60px 24px 80px;
    color: var(--cream);
}

/* 4.7 Botón volver */
.btn-volver {
    background: none;
    border: none;
    color: var(--text-muted-custom);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0;
    margin-bottom: 36px;
    display: inline-block;
    transition: color 0.25s;
}
.btn-volver:hover { color: var(--gold); }

/* 4.3 Cabecera: icono + título + precio */
.servicio-detail-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}
.servicio-detail-icon { font-size: 2.8rem; line-height: 1; flex-shrink: 0; }
.servicio-detail-titulo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.8rem;
    color: var(--cream);
    line-height: 1.1;
    margin: 0;
}
.servicio-detail-precio-badge {
    margin-left: auto;
    text-align: right;
    flex-shrink: 0;
}
.servicio-detail-precio {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.4rem;
    color: var(--gold);
    font-weight: 600;
    display: block;
    line-height: 1;
}
.servicio-detail-precio-label {
    font-size: 0.72rem;
    letter-spacing: 2px;
    color: var(--text-muted-custom);
    text-transform: uppercase;
}

/* 4.2 Carrusel */
.servicio-detail-carousel { border-radius: 4px; overflow: hidden; }
.servicio-detail-slide { height: 420px; }
.servicio-detail-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* Cuerpo del detalle */
.servicio-detail-body { max-width: 780px; }

/* 4.4 Descripción */
.servicio-detail-description {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--cream);
    opacity: 0.88;
    margin-bottom: 36px;
}

/* 4.6 Info cards */
.servicio-info-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 36px;
}
.servicio-info-card {
    background: var(--dark-2);
    border: 1px solid rgba(201,168,76,0.2);
    border-radius: 4px;
    padding: 20px 22px;
}
.servicio-info-card-label {
    font-size: 0.65rem;
    letter-spacing: 3px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 8px;
    font-family: 'Montserrat', sans-serif;
}
.servicio-info-card-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    color: var(--cream);
    margin: 0;
}

/* 4.5 Características */
.servicio-section-label {
    font-size: 0.65rem;
    letter-spacing: 3px;
    color: var(--text-muted-custom);
    text-transform: uppercase;
    margin-bottom: 16px;
    font-family: 'Montserrat', sans-serif;
}
.servicio-caracteristicas {
    list-style: none;
    padding: 0;
    margin: 0;
}
.servicio-caracteristicas li {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.88rem;
    color: var(--cream);
    opacity: 0.85;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    line-height: 1.5;
}
.servicio-caracteristicas li:last-child { border-bottom: none; }
.servicio-caracteristicas li::first-letter { color: var(--gold); }

/* 4.8 Responsive móvil */
@media (max-width: 768px) {
    .servicio-detail-slide { height: 250px; }
    .servicio-detail-titulo { font-size: 2rem; }
    .servicio-detail-precio { font-size: 1.8rem; }
    .servicio-info-cards { grid-template-columns: 1fr; }
    .servicio-detail-header { flex-direction: column; gap: 12px; }
    .servicio-detail-precio-badge { margin-left: 0; text-align: left; }
    .servicio-detail-page { padding: 36px 16px 60px; }
}

/* ── PANEL ADMIN ─────────────────────────────────────────────────────────── */

/* Tabs */
.admin-tabs-bar {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(185,149,77,0.2);
    padding-bottom: 0;
}
.admin-tab-btn {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted-custom);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 10px 18px 12px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    margin-bottom: -1px;
}
.admin-tab-btn:hover { color: var(--cream); }
.admin-tab-btn.active { color: var(--gold); border-bottom-color: var(--gold); }

/* Stats grid */
.admin-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}
.admin-stat-card {
    background: rgba(185,149,77,0.07);
    border: 1px solid rgba(185,149,77,0.2);
    border-radius: 10px;
    padding: 20px 24px;
}
.admin-stat-label {
    font-size: 0.68rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted-custom);
    margin-bottom: 8px;
}
.admin-stat-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.2rem;
    color: var(--gold);
    line-height: 1;
}

/* Table */
.admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
}
.admin-table th {
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted-custom);
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}
.admin-table td {
    padding: 12px 12px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    color: var(--text-muted-custom);
    vertical-align: middle;
}
.admin-table tr:hover td { background: rgba(255,255,255,0.02); }

/* Badge */
.admin-badge {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: rgba(185,149,77,0.12);
    color: var(--gold);
    border-radius: 20px;
    padding: 3px 10px;
}
.admin-badge--admin {
    background: rgba(155,89,182,0.15);
    color: #bb86fc;
}

/* Buttons */
.admin-btn {
    background: rgba(185,149,77,0.12);
    border: 1px solid rgba(185,149,77,0.35);
    color: var(--gold);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
    margin-right: 6px;
}
.admin-btn:hover { background: rgba(185,149,77,0.22); }
.admin-btn--danger {
    background: rgba(192,57,43,0.1);
    border-color: rgba(192,57,43,0.35);
    color: #e74c3c;
}
.admin-btn--danger:hover { background: rgba(192,57,43,0.2); }
.admin-btn--ghost {
    background: transparent;
    border-color: rgba(255,255,255,0.15);
    color: var(--text-muted-custom);
}
.admin-btn--ghost:hover { background: rgba(255,255,255,0.05); }

/* Form inputs inside modals */
.admin-form-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted-custom);
    margin-bottom: 6px;
}
.admin-form-input {
    width: 100%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(185,149,77,0.25);
    color: var(--cream);
    padding: 10px 14px;
    border-radius: 6px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
}
.admin-form-input:focus { outline: none; border-color: var(--gold); }
.admin-form-input option { background: #1a1a1a; }
.admin-form-error {
    font-size: 0.78rem;
    color: #e74c3c;
    letter-spacing: 0.5px;
    margin-bottom: 14px;
}

/* ── GOOGLE OAUTH BUTTON ── */
.btn-google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 10px;
    background: #fff;
    color: #444;
    border-radius: 6px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s;
    margin-top: 4px;
}
.btn-google:hover {
    background: #f1f1f1;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    color: #222;
}
.btn-google img {
    width: 20px;
    height: 20px;
}
.auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    color: rgba(255,255,255,0.3);
    font-size: 0.75rem;
    margin: 16px 0 12px;
}
.auth-divider::before,
.auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid rgba(255,255,255,0.15);
}
.auth-divider span { margin: 0 10px; }
